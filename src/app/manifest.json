{
  "name": "Upwork Message Extension",
  "description": "Upwork Message Extension",
  "version": "0.0.1",
  "manifest_version": 3,
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "webRequest",
    "scripting",
    "alarms"
  ],
  "background": {
    "service_worker": "background.bundle.js"
  },
  "options_page": "option.html",
  "action": {
    "default_title": "Upwork Message Extension",
    "default_icon": "images/upwork-logo.png",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "images/upwork-logo.png",
    "19": "images/upwork-logo.png",
    "38": "images/upwork-logo.png",
    "128": "images/upwork-logo.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.upwork.com/ab/messages/rooms/*"
      ],
      "js": [
        "upwork_sender_script.bundle.js"
      ]
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; worker-src 'self'"
  }
}